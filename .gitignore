# Raw source material (master deck, delivery transcripts) — private,
# potentially contains attendee names/questions. Not for git history even
# though this repo is private. Mirrors the pattern of the original
# CodingAgentsCourse repo's knowledge-base/ exclusion.
# Leading slash anchors this to the repo root only -- otherwise it also
# matches docs/assets/, which is where the site's own published images
# (logo, favicon) belong and must NOT be ignored.
/assets/
.DS_Store
